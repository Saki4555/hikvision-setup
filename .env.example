# =============================================
#  HIKVISION ATTENDANCE SYSTEM - CONFIG
# =============================================

# --- HRMS API ---
HRMS_API_URL=
HRMS_API_DEVICE_KEY=

# --- Polling interval (milliseconds) ---
POLL_INTERVAL_MS=10000

# --- Terminals (your Hikvision devices) ---
# One object per device. att_device_id must be unique per machine
# and never changed once it starts sending. in_out is ignored (API decides IN/OUT).
# password = that device's admin password (can differ per device).
TERMINALS=[{"ip":"xxx.xxx.xxx.xxx","in_out":3,"api_string":"http://xxx.xxx.xxx.xxx/ISAPI/AccessControl/AcsEvent?format=json","location":"Dhaka Center","att_device_id":"DHAKA-CENTER-01","device_location_id":25,"password":"your_device_password"}]

# For multiple devices:
# TERMINALS=[{"ip":"xxx.xxx.xxx.xxx","in_out":3,"api_string":"http://xxx.xxx.xxx.xxx/ISAPI/AccessControl/AcsEvent?format=json","location":"Dhaka Center","att_device_id":"DHAKA-CENTER-01","device_location_id":25,"password":"your_device_password"},{"ip":"xxx.xxx.xxx.xxx","in_out":3,"api_string":"http://xxx.xxx.xxx.xxx/ISAPI/AccessControl/AcsEvent?format=json","location":"Factory","att_device_id":"FACTORY-01","device_location_id":30,"password":"your_device_password"}]

NODE_ENV=development
# NODE_ENV=production

FALLBACK_DAYS=30